PORT=3001
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
FRONTEND_URL=http://localhost:5173

OPER_PASS_PIRACICABA=skoob123
OPER_PASS_CAMPINAS=skoob1234
OPER_PASS_INDAIATUBA=skoob12345
FIN_USER=controle@skoobpet.com.br
FIN_PASS=skoobdiretoria123

GCP_CLIENT_EMAIL=skoob-dashboard@dashboard-skoob-campinas.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SHEET_TAB=Folha1

# Campinas (retrocompatível: SHEET_ID = SHEET_ID_CAMPINAS)
SHEET_ID_CAMPINAS=1TTrjf0DZxWkIacYTp7_vcRmTx2-8XrobIaPgIflnyG8
# Piracicaba e Indaiatuba: informe o ID ou deixe vazio para buscar pelo nome
SHEET_ID_PIRACICABA=
SHEET_ID_INDAIATUBA=

# Nomes das planilhas no Google Drive (usados se SHEET_ID_* estiver vazio)
SHEET_NAME_CAMPINAS=Planilha SkoobPet (Campinas)
SHEET_NAME_PIRACICABA=Planilha SkoobPet (Piracicaba)
SHEET_NAME_INDAIATUBA=Planilha SkoobPet (Indaiatuba)

# Autenticação em duas etapas (logins das unidades)
TWO_FA_ENABLED=true
TWO_FA_EMAIL=contato@skoobpet.com.br
# Hostinger Email (padrão recomendado):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Se for Titan Mail na Hostinger, troque para:
# SMTP_HOST=smtp.titan.email
SMTP_USER=contato@skoobpet.com.br
SMTP_PASS=senha_do_email_contato
SMTP_FROM=contato@skoobpet.com.br
# Enquanto SMTP não estiver pronto, use temporariamente: TWO_FA_ENABLED=false

# E-mail de cada loja (destino de anexos e notificações)
STORE_EMAIL_CAMPINAS=skoobpet@outlook.com
STORE_EMAIL_PIRACICABA=skoobpetpiracicaba@outlook.com
STORE_EMAIL_INDAIATUBA=skoobpetindaiatuba@outlook.com

# PostgreSQL (EasyPanel) — assinaturas e anexos de contrato
# Sem DATABASE_URL, o sistema usa arquivos locais em backend/data/ (não recomendado em produção)
# DATABASE_URL=postgresql://usuario:senha@host:5432/skoobpet
# DATABASE_SSL=false

# ZapSign — contratos por unidade
# Token: Configurações > Integrações > ZapSign API
# Template ID: URL do modelo em app.zapsign.com.br/conta/modelos/{ID}
# ZAPSIGN_API_TOKEN=
# ZAPSIGN_TEMPLATE_ID_CAMPINAS=
# ZAPSIGN_TEMPLATE_ID_PIRACICABA=
# ZAPSIGN_TEMPLATE_ID_INDAIATUBA=
# Template limpo em produção (sem anexos legados da loja no link do cliente):
# ZAPSIGN_PRODUCTION_TEMPLATE_ID_CAMPINAS=
# ZAPSIGN_PRODUCTION_TEMPLATE_ID_PIRACICABA=
# ZAPSIGN_PRODUCTION_TEMPLATE_ID_INDAIATUBA=
# Se Piracicaba/Indaiatuba não tiverem template próprio, usa o de Campinas como fallback.
# Sandbox (testes sem consumir documentos/créditos de produção):
# ZAPSIGN_SANDBOX=true
# ZAPSIGN_SANDBOX_API_TOKEN=
# ZAPSIGN_SANDBOX_TEMPLATE_ID_CAMPINAS=
# ZAPSIGN_SANDBOX_TEMPLATE_ID_PIRACICABA=
# ZAPSIGN_SANDBOX_TEMPLATE_ID_INDAIATUBA=
# ZAPSIGN_CONFIGURE_FORM=true
# ZAPSIGN_SEND_EMAIL=false
# ZAPSIGN_EMAIL_VIA_SMTP=true
# ZAPSIGN_CREATED_BY=contato@skoobpet.com.br
# ZAPSIGN_BRAND_NAME=SkoobPet
# ZAPSIGN_LOJA_NAME=SkoobPet
# ZAPSIGN_LOJA_NAME_PIRACICABA=SkoobPet Piracicaba
# ZAPSIGN_LOJA_NAME_INDAIATUBA=SkoobPet Indaiatuba
# Link + código de assinatura via WhatsApp (requer telefone no contrato e créditos ZapSign ~R$0,50/msg)
# ZAPSIGN_SEND_WHATSAPP=true
# ZAPSIGN_CLIENT_AUTH_MODE=tokenWhatsapp
# ZAPSIGN_LOJA_AUTH_MODE=tokenWhatsapp
# ZAPSIGN_LOJA_NAME=SkoobPet
# ZAPSIGN_LOJA_EMAIL=contato@skoobpet.com.br
# ZAPSIGN_LOJA_PHONE=19991833826
